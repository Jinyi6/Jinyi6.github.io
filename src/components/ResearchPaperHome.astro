---
import { profile } from "@data/profile";
import { researchTracks } from "@data/research";
import { selectedWorks } from "@data/works";
import { systems } from "@data/systems";
import { timeline } from "@data/timeline";
import { honors, service } from "@data/recognition";
import { news } from "@data/news";
import { talks } from "@data/talks";

const topWorks = selectedWorks;

// Fetch Google Scholar citations at build time; fall back to "800+"
let scholarCitations = "900+";
try {
  const schRes = await fetch(
    "https://scholar.google.com/citations?user=kaQS7NAAAAAJ&hl=en",
    {
      headers: { "User-Agent": "Mozilla/5.0 (compatible; site-build/1.0)" },
      signal: AbortSignal.timeout(8000),
    }
  );
  if (schRes.ok) {
    const html = await schRes.text();
    const m = html.match(/<td class="gsc_rsb_std">(\d+)<\/td>/);
    if (m) scholarCitations = m[1];
  }
} catch { /* use fallback */ }

// Server-side RL day count (also updated client-side for daily accuracy)
const rlStartMs = Date.parse("2018-09-28");
const rlDaysServer = Math.floor((Date.now() - rlStartMs) / 86400000) + 1;
---

<article class="paper-page">
  <aside class="paper-index" aria-label="Page index">
    <a href="#overview">Overview</a>
    <a href="#news">News</a>
    <a href="#papers">Papers</a>
    <a href="#systems">Projects</a>
    <a href="#talks">Talks</a>
    <a href="#timeline">Timeline</a>
    <a href="#contact">Contact</a>
  </aside>

  <main class="paper-doc">
    <header id="overview" class="paper-hero">
      <div class="paper-hero-grid">
        <div class="paper-hero-title">
          <h1>{profile.name}<span>{profile.nativeName}</span></h1>
          <h2>{profile.headline}</h2>
        </div>

        <div class="paper-hero-body">
          <p class="paper-abstract">{profile.intro}</p>
          <div class="paper-links">
            <a href={`mailto:${profile.email}`}>Email</a>
            {profile.links.filter((link) => link.label !== "Email").map((link) => (
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            ))}
          </div>

          <div class="paper-metrics">
            {profile.metrics.map((metric) => (
              <div>
                <strong>
                  {"id" in metric && metric.id === "scholar-citations"
                    ? scholarCitations
                    : "id" in metric && metric.id === "rl-days"
                    ? <span id="rl-days">{rlDaysServer}</span>
                    : metric.value}
                </strong>
                <span>{metric.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="paper-hero-right">
          <aside class="paper-identity-card">
            <div class="paper-portrait-wrap">
              <img class="paper-portrait" src="/assets/avatar.jpg" alt={`Portrait of ${profile.name}`} />
            </div>
            <p class="paper-identity-label">{profile.role}</p>
            <h2>{profile.name}<span>{profile.nativeName}</span></h2>
            <div class="paper-identity-keywords">
              {profile.keywords.map((kw) => <span>{kw}</span>)}
            </div>
            <div class="paper-identity-meta">
              <a href={profile.lab.url} target="_blank" rel="noopener">{profile.lab.name}</a>
              <span>Tianjin University</span>
            </div>
            <p class="paper-identity-advisors">
              Advised by{" "}
              {profile.advisors.map((a, i) => (
                <>
                  {i > 0 && (i === profile.advisors.length - 1 ? ", and " : ", ")}
                  <a href={a.url} target="_blank" rel="noopener">{a.name}</a>
                </>
              ))}.
            </p>
            <div class="paper-identity-links">
              {profile.links.map((link) => (
                <a href={link.url}>{link.label}</a>
              ))}
            </div>
          </aside>

        </div>
      </div>

      <blockquote class="paper-hero-quote">
        {profile.quote.map((line, i) => (
          <>{line}{i < profile.quote.length - 1 && <br />}</>
        ))}
      </blockquote>
    </header>

    {/* Research Questions section hidden */}

    <section id="news" class="paper-section">
      <h2>News</h2>
      <div class="paper-news-card">
        <ul class="news-list">
          {news.map((item) => (
            <li>
              <time>{item.date}</time>
              <span>
                {item.emoji}{" "}
                {item.parts.map((part) =>
                  typeof part === "string"
                    ? part
                    : <a href={part.url} target="_blank" rel="noopener">{part.text}</a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="papers" class="paper-section">
      <h2>Selected Publications</h2>
      <p>
        The full publication archive remains available from the site navigation.
      </p>
      <div class="paper-publications">
        {topWorks.map((work) => (
          <article class={"image" in work ? "has-image" : ""}>
            <div>
              <h3>{work.title}</h3>
              <span>{work.theme} · {work.role}{work.venue ? ` · ${work.venue}` : ""}</span>
            </div>
            <p>{work.summary}</p>
            <footer>
              {work.links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
            </footer>
            {"image" in work && (
              <div class="pub-image">
                <img src={work.image} alt={work.title} />
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="systems" class="paper-section">
      <h2>Projects</h2>
      <div class="paper-systems">
        {systems.map((system) => (
          <a href={system.url} target="_blank" rel="noopener">
            <span>{system.eyebrow}</span>
            <h3>{system.title}</h3>
            <p>{system.summary}</p>
            <strong>{system.metric}</strong>
          </a>
        ))}
      </div>
    </section>

    <section id="talks" class="paper-section">
      <h2>Talks</h2>
      <ul class="talks-list">
        {talks.map((talk) => (
          <li>
            <time>{talk.date}</time>
            <span>
              <em>{talk.title}</em>
              <span class="talk-venue">{talk.venue}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section id="timeline" class="paper-section">
      <h2>Timeline</h2>
      <div class="paper-timeline-split">
        {timeline.map((item) => (
          <div class={`tls-item tls-${item.type}`}>
            {item.type === "work" ? (
              <>
                <div class="tls-card">
                  <time>{item.period}</time>
                  <h3>{item.title}</h3>
                  <p class="tls-org">{item.org}</p>
                  {item.advisor && <small>{item.advisor}</small>}
                  <p class="tls-summary">{item.summary}</p>
                </div>
                <div class="tls-mid"><span class="tls-dot"></span></div>
                <div class="tls-blank"></div>
              </>
            ) : (
              <>
                <div class="tls-blank"></div>
                <div class="tls-mid"><span class="tls-dot"></span></div>
                <div class="tls-card">
                  <time>{item.period}</time>
                  <h3>{item.title}</h3>
                  <p class="tls-org">{item.org}</p>
                  {item.advisor && <small>{item.advisor}</small>}
                  <p class="tls-summary">{item.summary}</p>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="paper-section paper-service">
      <h2>Honors and Service</h2>
      <div>
        <article>
          <h3>Selected Honors</h3>
          {honors.map((honor) => (
            <p>
              <strong>{honor.year}</strong>
              <span>
                {"emoji" in honor && <>{honor.emoji} </>}
                {"highlight" in honor && honor.highlight
                  ? <strong class={"tier" in honor ? `tier-${honor.tier}` : ""}>{honor.title}</strong>
                  : honor.title}
                {"note" in honor && <small class="honor-note">{honor.note}</small>}
              </span>
            </p>
          ))}
        </article>
        <article>
          <h3>Academic Service</h3>
          {service.map((item) => (
            <p class="service-row">
              <strong>{item.label}</strong>
              {"items" in item
                ? <span class="service-items">
                    {item.items.map((line) => (
                      typeof line === "string"
                        ? <span>{line}</span>
                        : <span><a href={line.url} target="_blank" rel="noopener">{line.text}</a></span>
                    ))}
                  </span>
                : <span>{item.text}</span>}
            </p>
          ))}
        </article>
      </div>
    </section>

    <section id="contact" class="paper-contact">
      <h2>Contact</h2>
      <div class="contact-grid">
        <ul class="contact-channels">
          <li>
            <span class="channel-label">Collaboration</span>
            <p>Open to conversations on LLM post-training, RL, agents, and AI4S.</p>
          </li>
          <li>
            <span class="channel-label">PhD / Interns</span>
            <p><a href="http://www.icdai.org/" target="_blank" rel="noopener">TJU DRL Lab</a> is welcoming motivated research interns and prospective MS/PhD students.</p>
          </li>
          <li>
            <span class="channel-label">MemoraX AI</span>
            <p><a href="https://memorax.net/" target="_blank" rel="noopener">MemoraX AI</a> is open for collaboration on Agent / Memory research — intern, full-time, or research partnership.</p>
          </li>
        </ul>
        <div class="contact-right">
          <span class="channel-label">Find me on</span>
          <div class="contact-social-grid">
            <a class="contact-email-cta" href={`mailto:${profile.email}`}>{profile.email} →</a>
            {profile.links.filter((l) => !l.url.startsWith("mailto")).map((link) => (
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</article>

<script>
  (function () {
    const start = Date.parse("2018-09-28");
    function update() {
      const days = Math.floor((Date.now() - start) / 86400000) + 1;
      const el = document.getElementById("rl-days");
      if (el) el.textContent = String(days);
    }
    update();
    const now = new Date();
    const msToMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).getTime() - Date.now();
    setTimeout(function tick() {
      update();
      setTimeout(tick, 86400000);
    }, msToMidnight);
  })();
</script>
